# Source database connection settings
SOURCE_DB_PASSWORD=source123
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432

# Warehouse database connection settings
WAREHOUSE_DB_PASSWORD=warehouse123
WAREHOUSE_DB_HOST=localhost
WAREHOUSE_DB_PORT=5433

# Airflow metadata database connection settings
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow123
AIRFLOW_DB=airflow

# Airflow settings
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin123

# Generate Fernet key with: uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here

# Generate JWT secret with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_secret_here
AIRFLOW__API_AUTH__JWT_ISSUER=ecommerce-data-platform-airflow-local

# dbt target environment
DBT_TARGET=dev

# Webhook URL for alerts
ALERT_WEBHOOK_URL=your_webhook_url_here
